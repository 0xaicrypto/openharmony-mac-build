import("//build/ohos.gni")

ohos_rust_shared_library("hilog_rust") {
  sources = [ "src/lib.rs" ]

  deps = [ ":hilog_rust_static" ]

  crate_name = "hilog_rust"
  crate_type = "dylib"
  rustflags = [ "-Zstack-protector=all" ]

  subsystem_name = "hiviewdfx"
  part_name = "hilog"
}

# darwin port: darwin rustc 无法加载 ELF dylib, 提供同名 rlib 供依赖方编译期使用
ohos_rust_static_library("hilog_rust_static") {
  sources = [ "src/lib.rs" ]

  deps = [ "../../interfaces/native/innerkits:libhilog" ]

  crate_name = "hilog_rust_static"
  rustflags = [ "-Zstack-protector=all" ]

  subsystem_name = "hiviewdfx"
  part_name = "hilog"
}

group("rust_hilog_component") {
  deps = [ ":hilog_rust" ]
}
